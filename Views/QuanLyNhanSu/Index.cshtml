@model IEnumerable<WebDienThoai.Models.NhanVienListItemViewModel>

@{
    ViewBag.Title = "Quản lý nhân sự";
    Layout = "~/Views/Shared/_LayoutQT.cshtml";
}

<div class="bg-white p-4 rounded-3 shadow-sm">
    <div class="d-flex flex-column " style="min-height: 80vh;">
        <h2>Quản lý nhân sự</h2>

        <p>
            @Html.ActionLink("Thêm nhân viên mới", "Create", "QuanLyNhanSu", null, new { @class = "btn btn-primary" })
        </p>

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên đăng nhập</th>
                    <th>Họ tên</th>
                    <th>SĐT</th>
                    <th>Email</th>
                    <th>Chức vụ</th>
                    <th>Ngày vào làm</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.ID</td>
                        <td>@u.UserName</td>
                        <td>@u.HoTen</td>
                        <td>@u.SDT</td>
                        <td>@u.Email</td>

                        <td style="min-width:220px;">
                            @using (Html.BeginForm("ChangeRole", "QuanLyNhanSu", FormMethod.Post, new { @class = "d-flex gap-2 align-items-center" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.ID" />

                                <select name="roleCode" class="form-select form-select-sm">
                                    <option value="ADMIN" @(u.RoleCode == "ADMIN" ? "selected" : "")>ADMIN - Quản lý</option>
                                    <option value="NVKHO" @(u.RoleCode == "NVKHO" ? "selected" : "")>NVKHO - Nhân viên Kho</option>
                                    <option value="NVSP" @(u.RoleCode == "NVSP" ? "selected" : "")>NVSP - Nhân viên bán hàng</option>
                                    <option value="KHACH" @(u.RoleCode == "KHACH" ? "selected" : "")>KHACH - Khách hàng</option>
                                </select>

                                <button type="submit" class="btn btn-sm btn-primary">Lưu</button>
                            }
                        </td>

                        <td>@(u.NgayVaoLam.HasValue ? u.NgayVaoLam.Value.ToString("dd/MM/yyyy") : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>