@model WebDienThoai.Models.ResetPasswordWithOtpViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đặt lại mật khẩu</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="@Url.Content("~/Content/Login.css")">
</head>
<body>
    <a href='@Url.Action("Index", "Home")' class="back-btn">
        <i class="fas fa-arrow-left"></i>
        <span>Quay về trang chủ</span>
    </a>

    <div class="login-container">
        <div class="form-header">
            <img src="@Url.Content("~/Content/Anh/logo/headerlogo.png")" alt="HANDPHONE STORE Logo" style="width: 100px; margin-bottom: 10px;">
            <p class="form-title" style="color: #333;">Đặt lại mật khẩu</p>
        </div>

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info text-center" style="margin-bottom: 20px;">
                @TempData["Info"]
            </div>
        }

        @using (Html.BeginForm("ResetPasswordOtp", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger text-center mb-3" })

            @Html.HiddenFor(m => m.UserName)

            <div class="form-group">
                @Html.LabelFor(m => m.Otp, "Mã xác thực")
                <div class="input-wrapper">
                    @Html.TextBoxFor(m => m.Otp, new { placeholder = "Nhập mã OTP", required = "required"})
                    <span class="input-icon"><i class="fas fa-key"></i></span>
                </div>
                @Html.ValidationMessageFor(m => m.Otp, "", new { @class = "text-danger small mt-1" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.NewPassword, "Mật khẩu mới")
                <div class="input-wrapper">
                    @Html.PasswordFor(m => m.NewPassword, new { placeholder = "Mật khẩu mới", required = "required"})
                    <span class="input-icon"><i class="fas fa-lock"></i></span>
                </div>
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small mt-1" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.ConfirmNewPassword, "Nhập lại mật khẩu mới")
                <div class="input-wrapper">
                    @Html.PasswordFor(m => m.ConfirmNewPassword, new { placeholder = "Nhập lại mật khẩu", required = "required"})
                    <span class="input-icon"><i class="fas fa-lock"></i></span>
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmNewPassword, "", new { @class = "text-danger small mt-1" })
            </div>

            <button type="submit" class="btn-submit">Đặt lại mật khẩu</button>
        }

        <div class="register-link">
            @Html.ActionLink("Đăng nhập", "Login", "Account")
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>
